/*
 * Radioberry 2.x on the Raspberry Pi 5. Installed as radioberry.dtbo and
 * enabled with "dtoverlay=radioberry" in config.txt.
 *
 * The control interface is spi0 chip select 0 in SPI mode 3. The FPGA's
 * passive serial configuration lines are GPIOs handed to the driver. The
 * stream pins (4, 5, 6, 12, 18 to 21, 25) are given to the RP1 PIO by the
 * driver at run time and are not listed here.
 *
 * Parameter: spi_speed=<Hz> (default 12.5 MHz; the gateware's timing
 * constraints allow up to 15.625 MHz).
 */
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	fragment@0 {
		target = <&spidev0>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@1 {
		target = <&spidev1>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@2 {
		target = <&rp1_pio>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@3 {
		target = <&spi0>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			radioberry: radioberry@0 {
				compatible = "sdr,radioberry";
				reg = <0>;
				spi-max-frequency = <12500000>;
				spi-cpol;
				spi-cpha;
				nconfig-gpios = <&rp1_gpio 27 0>;
				dclk-gpios = <&rp1_gpio 24 0>;
				data0-gpios = <&rp1_gpio 13 0>;
				conf-done-gpios = <&rp1_gpio 22 0>;
				nstatus-gpios = <&rp1_gpio 26 0>;
				status = "okay";
			};
		};
	};

	__overrides__ {
		spi_speed = <&radioberry>, "spi-max-frequency:0";
	};
};
