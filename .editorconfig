root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yaml,yml,json}]
indent_size = 2

[{Makefile,Kbuild,*.mk}]
indent_style = tab
indent_size = 8

[driver/**.{c,h}]
indent_style = tab
indent_size = 8
