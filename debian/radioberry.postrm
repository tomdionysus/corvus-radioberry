#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -e

case "$1" in
    remove | purge)
        for f in radioberry.rbf radioberry-rpi4-i2s.rbf; do
            if [ -L "/usr/lib/firmware/$f" ]; then
                rm -f "/usr/lib/firmware/$f"
            fi
        done
        rm -f /boot/firmware/overlays/radioberry.dtbo /boot/firmware/overlays/radioberry-i2s.dtbo
        ;;
esac

#DEBHELPER#
