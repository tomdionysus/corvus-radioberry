#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -e

if [ "$1" = configure ]; then
    # Up to release 0.4.1 the install asked which FPGA the board has; the
    # images are for the 10CL025 only now. (Sourcing the confmodule runs
    # this script again under debconf, so this comes first.)
    if [ -e /usr/share/debconf/confmodule ]; then
        . /usr/share/debconf/confmodule
        db_purge || true
        db_stop
    fi

    # The driver loads the image for its board from /usr/lib/firmware.
    for image in rpi5-pio rpi4-i2s; do
        ln -sfn "/usr/share/radioberry/gateware/$image/CL025/radioberry-$image.rbf" \
            "/usr/lib/firmware/radioberry-$image.rbf"
    done
    # Up to release 0.4.1: the Hermes-Lite 2 PIO image.
    if [ -L /usr/lib/firmware/radioberry.rbf ]; then
        rm -f /usr/lib/firmware/radioberry.rbf
    fi

    # The firmware reads overlays from /boot/firmware/overlays, a FAT
    # file system dpkg cannot manage files on.
    if [ -d /boot/firmware/overlays ]; then
        cp /usr/share/radioberry/overlays/radioberry.dtbo /boot/firmware/overlays/radioberry.dtbo.new
        mv /boot/firmware/overlays/radioberry.dtbo.new /boot/firmware/overlays/radioberry.dtbo
        # No longer needed: the driver sets up a Raspberry Pi 4 itself.
        rm -f /boot/firmware/overlays/radioberry-i2s.dtbo
    else
        echo "radioberry: /boot/firmware/overlays not found; copy" \
            "/usr/share/radioberry/overlays/radioberry.dtbo there." >&2
    fi
    if grep -qs '^dtoverlay=radioberry-i2s' /boot/firmware/config.txt; then
        echo "radioberry: the dtoverlay=radioberry-i2s line in /boot/firmware/config.txt" \
            "is no longer needed; remove it." >&2
    fi

    # The radioberry user and group, then /dev/radioberry's group.
    systemd-sysusers radioberry.conf
    if command -v udevadm >/dev/null; then
        udevadm control --reload-rules || true
        udevadm trigger --action=add --subsystem-match=misc --sysname-match=radioberry || true
    fi

    if ! grep -qs '^dtoverlay=radioberry$' /boot/firmware/config.txt; then
        echo "radioberry: add 'dtparam=i2c_arm=on' and 'dtoverlay=radioberry' to" \
            "/boot/firmware/config.txt and reboot to enable the RadioBerry." >&2
    fi
fi

#DEBHELPER#

# dh_installsystemd --no-start adds no daemon-reload, so systemd would
# keep the unit file it loaded before this one was unpacked (and warn on
# the stop below).
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

# An upgrade builds the new driver (radioberry-dkms is configured first)
# and installs new gateware, but leaves the old driver loaded and the old
# gateware in the FPGA. Load both now (the driver loads the gateware), or
# say a reboot is needed if the driver is in use. Always: the version
# string does not change between builds of one release, and new gateware
# alone needs the reload too.
if [ "$1" = configure ] && [ -e /sys/module/radioberry ]; then
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop radioberry.service >/dev/null || true
    fi
    if modprobe -r radioberry 2>/dev/null && modprobe radioberry; then
        # The driver loads the gateware before /dev/radioberry appears.
        for i in $(seq 1 30); do
            [ -c /dev/radioberry ] && break
            sleep 1
        done
    else
        echo "radioberry: the driver is in use; reboot to load the new driver and gateware." >&2
    fi
fi

# radioberry.service binds to /dev/radioberry: start it now only if the
# driver is already up; otherwise it starts at the next boot.
if [ "$1" = configure ] && [ -d /run/systemd/system ] && [ -c /dev/radioberry ]; then
    deb-systemd-invoke restart radioberry.service >/dev/null || true
fi
