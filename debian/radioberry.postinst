#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -e

if [ "$1" = configure ]; then
    . /usr/share/debconf/confmodule
    db_get radioberry/fpga
    fpga="$RET"
    case "$fpga" in
        CL016 | CL025) ;;
        *) fpga=CL025 ;;
    esac
    # The driver loads /usr/lib/firmware/radioberry.rbf.
    ln -sfn "/usr/share/radioberry/gateware/rpi-5/$fpga/radioberry.rbf" \
        /usr/lib/firmware/radioberry.rbf
    # With the radioberry-i2s overlay (Raspberry Pi 4) it loads the
    # gateware-v2 receive image instead, built for the 10CL025 only.
    i2s="/usr/share/radioberry/gateware/rpi4-i2s/$fpga/radioberry-rpi4-i2s.rbf"
    if [ -f "$i2s" ]; then
        ln -sfn "$i2s" /usr/lib/firmware/radioberry-rpi4-i2s.rbf
    elif [ -L /usr/lib/firmware/radioberry-rpi4-i2s.rbf ]; then
        rm -f /usr/lib/firmware/radioberry-rpi4-i2s.rbf
    fi

    # The firmware reads overlays from /boot/firmware/overlays, a FAT
    # file system dpkg cannot manage files on.
    if [ -d /boot/firmware/overlays ]; then
        for o in radioberry radioberry-i2s; do
            [ -f "/usr/share/radioberry/overlays/$o.dtbo" ] || continue
            cp "/usr/share/radioberry/overlays/$o.dtbo" "/boot/firmware/overlays/$o.dtbo.new"
            mv "/boot/firmware/overlays/$o.dtbo.new" "/boot/firmware/overlays/$o.dtbo"
        done
    else
        echo "radioberry: /boot/firmware/overlays not found; copy" \
            "/usr/share/radioberry/overlays/radioberry.dtbo there." >&2
    fi

    # The radioberry user and group, then /dev/radioberry's group.
    systemd-sysusers radioberry.conf
    if command -v udevadm >/dev/null; then
        udevadm control --reload-rules || true
        udevadm trigger --action=add --subsystem-match=misc --sysname-match=radioberry || true
    fi

    if ! grep -qs '^dtoverlay=radioberry' /boot/firmware/config.txt; then
        echo "radioberry: add 'dtparam=i2c_arm=on' and 'dtoverlay=radioberry' to" \
            "/boot/firmware/config.txt and reboot to enable the RadioBerry." >&2
    fi
fi

#DEBHELPER#

# dh_installsystemd --no-start adds no daemon-reload, so systemd would
# keep the unit file it loaded before this one was unpacked (and warn on
# the stop below).
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

# An upgrade builds the new driver (radioberry-dkms is configured first)
# but leaves the old one loaded: load the new one now, or say a reboot is
# needed if the old one is in use.
if [ "$1" = configure ] && [ -e /sys/module/radioberry/version ]; then
    loaded=$(cat /sys/module/radioberry/version)
    built=$(modinfo -F version radioberry 2>/dev/null || true)
    if [ -n "$built" ] && [ "$loaded" != "$built" ]; then
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop radioberry.service >/dev/null || true
        fi
        if modprobe -r radioberry 2>/dev/null && modprobe radioberry; then
            # The driver loads the gateware before /dev/radioberry appears.
            for i in $(seq 1 30); do
                [ -c /dev/radioberry ] && break
                sleep 1
            done
        else
            echo "radioberry: driver $loaded is in use; reboot to load $built." >&2
        fi
    fi
fi

# radioberry.service binds to /dev/radioberry: start it now only if the
# driver is already up; otherwise it starts at the next boot.
if [ "$1" = configure ] && [ -d /run/systemd/system ] && [ -c /dev/radioberry ]; then
    deb-systemd-invoke restart radioberry.service >/dev/null || true
fi
