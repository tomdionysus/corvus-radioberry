#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -e

# dh_installsystemd --no-start adds no stop; stop the daemon on removal.
# On upgrade it keeps running until the new postinst restarts it.
case "$1" in
    remove | deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop radioberry.service >/dev/null || true
        fi
        ;;
esac

#DEBHELPER#
